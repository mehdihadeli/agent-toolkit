{
	"servers": {
		"io.github.upstash/context7": {
		  "type": "stdio",
		  "command": "npx",
		  "args": ["-y", "@upstash/context7-mcp@latest"],
		  "gallery": "https://api.mcp.github.com",
		  "version": "latest"
		},
		"microsoft.docs.mcp": {
			"url": "https://learn.microsoft.com/api/mcp",
			"type": "http"
		}
	},
	"inputs": [
		{
			"id": "CONTEXT7_API_KEY",
			"type": "promptString",
			"description": "API key for authentication",
			"password": true
		}
	]
}