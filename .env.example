# Copy to .env for local development. Never commit real credentials.

# Providers are opt-in by default.
Search__EnableTavily=false

# Tavily Search and Extract.
TAVILY_API_KEY=your-tavily-api-key
# SEARCH_PROVIDER=tavily

# Vally Copilot SDK BYOK provider.
# Export this file before running Vally; Vally reads the key through apiKeyEnv.
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash
OPENAI_API_KEY=your-deepseek-api-key

# Claude Code Vally executor. Endpoint must be Anthropic-compatible.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=your-anthropic-api-key
